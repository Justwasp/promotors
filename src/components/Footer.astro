---
import { SITE_CONFIG } from '../config/site';
import type { TranslationDictionary } from '../i18n/types';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/8 bg-carbon py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <div>
        <div class="font-display text-2xl font-extrabold tracking-wide uppercase">
          <span class="text-pro-green">{SITE_CONFIG.brandWordmark.prefix}</span>
          <span class="text-text-primary">{SITE_CONFIG.brandWordmark.suffix}</span>
        </div>
        <p class="mt-1 text-sm text-text-secondary">{t.footer.tagline}</p>
      </div>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-text-secondary">
        <a
          href={SITE_CONFIG.social.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-pro-green"
        >
          Instagram ({SITE_CONFIG.social.instagramHandle}) ↗
        </a>
        <a
          href={SITE_CONFIG.social.facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-pro-green"
        >
          Facebook ↗
        </a>
        <a
          href={SITE_CONFIG.social.partsShopUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-pro-green"
        >
          {t.footer.partsShop} ↗
        </a>
        <button
          type="button"
          data-open-privacy
          class="cursor-pointer transition-colors hover:text-text-primary"
        >
          {t.footer.privacyLink}
        </button>
        <a
          href={SITE_CONFIG.legal.livroReclamacoesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-text-primary"
        >
          {t.footer.livroReclamacoes} ↗
        </a>
      </div>
    </div>

    <div class="mt-6 flex flex-col justify-between gap-2 border-t border-white/8 pt-5 text-xs text-text-secondary sm:flex-row">
      <p>© {currentYear} {SITE_CONFIG.brandName}. {t.footer.rights}</p>
      <p>{SITE_CONFIG.address.full}</p>
    </div>
  </div>
</footer>
