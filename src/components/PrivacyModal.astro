---
import type { TranslationDictionary } from '../i18n/types';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
const dialogAttrs = { closedby: 'any' } as Record<string, string>;
---

<!-- Native <dialog> opened via showModal(); no redundant role="dialog" or aria-modal -->
<dialog
  id="privacy-dialog"
  aria-labelledby="privacy-dialog-title"
  {...dialogAttrs}
  class="m-auto max-h-[85dvh] w-[min(92vw,38rem)] overflow-hidden rounded-3xl border border-white/12 bg-carbon p-0 text-text-primary shadow-2xl"
>
  <div class="flex items-center justify-between border-b border-white/8 px-6 py-4">
    <h1 id="privacy-dialog-title" class="font-display text-2xl font-extrabold uppercase text-text-primary">
      {t.privacy.title}
    </h1>
    <form method="dialog">
      <button
        type="submit"
        aria-label={t.privacy.closeCta}
        class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-white/10 bg-asphalt text-text-secondary transition-colors hover:border-white/25 hover:text-text-primary"
      >
        ✕
      </button>
    </form>
  </div>

  <div class="space-y-4 overflow-y-auto px-6 py-5 text-sm leading-relaxed text-text-secondary">
    <p class="text-text-primary">{t.privacy.intro}</p>

    <div>
      <h2 class="font-semibold text-text-primary">{t.privacy.dataCollectedTitle}</h2>
      <p class="mt-1">{t.privacy.dataCollectedBody}</p>
    </div>

    <div>
      <h2 class="font-semibold text-text-primary">{t.privacy.purposeTitle}</h2>
      <p class="mt-1">{t.privacy.purposeBody}</p>
    </div>

    <div>
      <h2 class="font-semibold text-text-primary">{t.privacy.retentionTitle}</h2>
      <p class="mt-1">{t.privacy.retentionBody}</p>
    </div>

    <div>
      <h2 class="font-semibold text-text-primary">{t.privacy.rightsTitle}</h2>
      <p class="mt-1">{t.privacy.rightsBody}</p>
    </div>
  </div>

  <div class="flex justify-end border-t border-white/8 px-6 py-4">
    <form method="dialog">
      <button
        type="submit"
        autofocus
        class="cursor-pointer rounded-xl bg-pro-green px-5 py-2 text-sm font-bold text-asphalt transition-colors hover:bg-pro-green-hover"
      >
        {t.privacy.closeCta}
      </button>
    </form>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('privacy-dialog') as HTMLDialogElement | null;

  if (dialog) {
    document.querySelectorAll<HTMLButtonElement>('[data-open-privacy]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (!dialog.open) {
          dialog.showModal();
        }
      });
    });

    dialog.addEventListener('close', () => {
      dialog.returnValue = '';
    });

    // Mandatory Safari fallback for <dialog closedby="any"> light-dismiss
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      const isOutside = (event: PointerEvent) => {
        const rect = dialog.getBoundingClientRect();
        return (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        );
      };

      let pressedOutside = false;
      dialog.addEventListener('pointerdown', (event) => {
        pressedOutside = isOutside(event);
      });
      dialog.addEventListener('pointerup', (event) => {
        if (pressedOutside && isOutside(event)) {
          dialog.close();
        }
      });
    }
  }
</script>
