---
import { SITE_CONFIG } from '../config/site';
import { withBase } from '../lib/paths';
import type { Locale, TranslationDictionary } from '../i18n/types';

interface Props {
  locale: Locale;
  t: TranslationDictionary;
}

const { locale, t } = Astro.props;
const ptHref = withBase('/');
const enHref = withBase('/en/');
const homeHref = locale === 'en' ? enHref : ptHref;
---

<header class="sticky top-0 z-40 border-b border-white/8 bg-asphalt/88 backdrop-blur-md">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href={homeHref}
      class="group inline-flex items-center gap-1.5 font-display text-3xl font-extrabold tracking-wide uppercase"
      aria-label={SITE_CONFIG.brandName}
    >
      <span class="text-pro-green transition-colors group-hover:text-pro-green-hover">
        {SITE_CONFIG.brandWordmark.prefix}
      </span>
      <span class="text-text-primary">{SITE_CONFIG.brandWordmark.suffix}</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-text-secondary lg:flex" aria-label="Primary">
      <a href="#servicos" class="transition-colors hover:text-text-primary">{t.nav.services}</a>
      <a href="#instagram" class="transition-colors hover:text-text-primary">{t.nav.instagram}</a>
      <a href="#marcacao" class="transition-colors hover:text-text-primary">{t.nav.booking}</a>
      <a href="#contactos" class="transition-colors hover:text-text-primary">{t.nav.contacts}</a>
      <a
        href={SITE_CONFIG.social.partsShopUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-text-secondary transition-colors hover:text-pro-green"
      >
        <span>{t.nav.partsShop}</span>
        <span aria-hidden="true" class="text-xs">↗</span>
      </a>
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <div
        class="inline-flex items-center rounded-lg border border-white/10 bg-carbon p-0.5 text-xs font-semibold"
        role="group"
        aria-label="Language"
      >
        <a
          href={ptHref}
          class:list={[
            'rounded-md px-2.5 py-1.5 transition-colors',
            locale === 'pt'
              ? 'bg-carbon-elevated text-text-primary'
              : 'text-text-secondary hover:text-text-primary',
          ]}
          aria-current={locale === 'pt' ? 'page' : undefined}
        >
          PT
        </a>
        <a
          href={enHref}
          class:list={[
            'rounded-md px-2.5 py-1.5 transition-colors',
            locale === 'en'
              ? 'bg-carbon-elevated text-text-primary'
              : 'text-text-secondary hover:text-text-primary',
          ]}
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          EN
        </a>
      </div>

      <a
        href="#marcacao"
        class="hidden rounded-lg bg-pro-green px-4 py-2 text-sm font-bold text-asphalt transition-colors hover:bg-pro-green-hover sm:inline-flex"
      >
        {t.nav.bookCta}
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-carbon text-text-primary transition-colors hover:border-white/20 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label={t.nav.openMenu}
        data-open-label={t.nav.openMenu}
        data-close-label={t.nav.closeMenu}
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav-panel"
    hidden
    class="border-t border-white/8 bg-carbon px-4 py-4 lg:hidden"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col gap-3 text-base font-medium">
      <a href="#servicos" data-mobile-nav-link class="rounded-lg px-3 py-2 text-text-secondary hover:bg-carbon-elevated hover:text-text-primary">
        {t.nav.services}
      </a>
      <a href="#instagram" data-mobile-nav-link class="rounded-lg px-3 py-2 text-text-secondary hover:bg-carbon-elevated hover:text-text-primary">
        {t.nav.instagram}
      </a>
      <a href="#marcacao" data-mobile-nav-link class="rounded-lg px-3 py-2 text-text-secondary hover:bg-carbon-elevated hover:text-text-primary">
        {t.nav.booking}
      </a>
      <a href="#contactos" data-mobile-nav-link class="rounded-lg px-3 py-2 text-text-secondary hover:bg-carbon-elevated hover:text-text-primary">
        {t.nav.contacts}
      </a>
      <a
        href={SITE_CONFIG.social.partsShopUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between rounded-lg px-3 py-2 text-pro-green hover:bg-carbon-elevated"
      >
        <span>{t.nav.partsShop} (promotorsparts.com)</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');

  if (toggleBtn && mobilePanel) {
    const closeMenu = () => {
      mobilePanel.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', toggleBtn.dataset.openLabel ?? 'Open menu');
    };

    toggleBtn.addEventListener('click', () => {
      const isOpen = !mobilePanel.hidden;
      if (isOpen) {
        closeMenu();
      } else {
        mobilePanel.hidden = false;
        toggleBtn.setAttribute('aria-expanded', 'true');
        toggleBtn.setAttribute('aria-label', toggleBtn.dataset.closeLabel ?? 'Close menu');
      }
    });

    mobilePanel.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>
