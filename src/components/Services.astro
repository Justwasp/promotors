---
import { SITE_CONFIG } from '../config/site';
import { SERVICES, type ServiceDefinition } from '../data/services';
import type { TranslationDictionary } from '../i18n/types';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;

function getIconPaths(icon: ServiceDefinition['icon']): string {
  switch (icon) {
    case 'wrench':
      return '<path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z"/>';
    case 'oil':
      return '<path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0L12 2.69Z"/><path stroke-linecap="round" d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>';
    case 'brake':
      return '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path stroke-linecap="round" d="M12 6v1m0 10v1M6 12h1m10 0h1m-2.5-4.3-.7.7m-5.6 5.6-.7.7"/>';
    case 'tire':
      return '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path stroke-linecap="round" d="M12 7.5V12m0 0 3.8 2.2M12 12l-3.8 2.2"/>';
    case 'gear':
      return '<circle cx="12" cy="12" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c0 .66.39 1.26 1 1.51.16.07.33.1.51.1H21a2 2 0 0 1 0 4h-.09c-.66 0-1.26.39-1.51 1Z"/>';
    case 'scooter':
      return '<circle cx="6" cy="17" r="2.5"/><circle cx="18" cy="17" r="2.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M8.5 17H14l1.5-5.5H12L10.5 14H6M15.5 11.5l-1-4.5H17m-8 4H5.5a1.5 1.5 0 0 0-1.5 1.5V15"/>';
  }
}
---

<section id="servicos" class="scroll-mt-20 border-b border-white/8 bg-asphalt py-18 sm:py-22">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium tracking-widest text-pro-green uppercase">
        {t.services.eyebrow}
      </p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight uppercase sm:text-5xl">
        {t.services.heading}
      </h2>
      <p class="mt-3 text-base text-text-secondary">
        {t.services.subheading}
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((service) => {
        const copy = t.services.items[service.id];
        return (
          <button
            type="button"
            data-select-service={service.id}
            class="group flex flex-col justify-between rounded-2xl border border-white/8 bg-carbon p-6 text-left transition-all hover:-translate-y-0.5 hover:border-pro-green/45 hover:bg-carbon-elevated"
          >
            <div>
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-pro-green/25 bg-pro-green/12 text-pro-green transition-colors group-hover:bg-pro-green/20">
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                  set:html={getIconPaths(service.icon)}
                />
              </div>
              <h3 class="mt-5 text-lg font-bold text-text-primary">
                {copy.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-text-secondary">
                {copy.description}
              </p>
            </div>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-pro-green transition-transform group-hover:translate-x-1">
              <span>{t.services.cardCta}</span>
              <span aria-hidden="true">→</span>
            </span>
          </button>
        );
      })}
    </div>

    <!-- Parts shop cross-link strip (promotorsparts.com) -->
    <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-2xl border border-white/8 bg-carbon px-6 py-5 sm:flex-row sm:items-center">
      <div>
        <h3 class="text-base font-bold text-text-primary">{t.services.partsBannerTitle}</h3>
        <p class="mt-1 text-sm text-text-secondary">{t.services.partsBannerSubtitle}</p>
      </div>
      <a
        href={SITE_CONFIG.social.partsShopUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-pro-green/40 bg-pro-green/12 px-4 py-2.5 text-sm font-semibold text-pro-green transition-colors hover:bg-pro-green hover:text-asphalt"
      >
        <span>{t.services.partsBannerCta}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-select-service]').forEach((card) => {
    card.addEventListener('click', () => {
      const serviceId = card.dataset.selectService;
      if (!serviceId) return;

      window.dispatchEvent(new CustomEvent('promotors:select-service', { detail: { serviceId } }));

      const bookingSection = document.getElementById('marcacao');
      bookingSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
