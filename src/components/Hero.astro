---
import { SITE_CONFIG } from '../config/site';
import { withBase } from '../lib/paths';
import type { TranslationDictionary } from '../i18n/types';

interface Props {
  t: TranslationDictionary;
}

const { t } = Astro.props;
const heroImgSrc = withBase('/images/hero-motorcycle.jpg');
---

<section class="relative overflow-hidden border-b border-white/8 bg-asphalt">
  <!-- Single LCP image: dedicated bright top showcase on mobile, asymmetric background on desktop -->
  <div class="relative h-[235px] w-full overflow-hidden sm:h-[300px] lg:pointer-events-none lg:absolute lg:inset-0 lg:h-full">
    <img
      src={heroImgSrc}
      alt={t.hero.imageAlt}
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full origin-[86%_56%] scale-[1.32] object-cover object-[84%_56%] brightness-[1.2] contrast-[1.06] sm:origin-[82%_54%] sm:scale-[1.2] lg:origin-center lg:scale-100 lg:object-right lg:opacity-85 lg:brightness-100 lg:contrast-100"
    />
    <!-- Mobile subtle edge vignettes (keep motorcycle crisp & bright in the center) -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-asphalt/55 to-transparent lg:hidden"
    />
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-asphalt via-asphalt/45 to-transparent lg:hidden"
    />
    <!-- Desktop seamless left-to-right contrast scrim -->
    <div
      class="hidden bg-gradient-to-r from-asphalt via-asphalt/92 via-45% to-asphalt/20 lg:absolute lg:inset-0 lg:block"
    />
  </div>

  <div class="relative z-10 mx-auto -mt-7 max-w-7xl px-4 pb-10 sm:-mt-8 sm:px-6 sm:pb-14 lg:mt-0 lg:px-8 lg:py-28">
    <div class="max-w-2xl">
      <!-- Live status badge computed client-side in Europe/Lisbon time -->
      <div
        id="workshop-status-pill"
        data-open-text={t.hero.openNow}
        data-closed-text={t.hero.closedNow}
        class="inline-flex flex-col items-start gap-0.5 rounded-2xl border border-white/12 bg-carbon/95 px-3.5 py-2 font-mono text-[11px] tracking-wide text-text-secondary shadow-lg backdrop-blur-md sm:flex-row sm:items-center sm:gap-2 sm:rounded-full sm:py-1.5 sm:text-xs"
      >
        <span class="inline-flex items-center gap-2 whitespace-nowrap">
          <span
            id="workshop-status-dot"
            class="h-2 w-2 shrink-0 rounded-full bg-pro-green shadow-[0_0_8px_rgba(82,175,61,0.85)]"
            aria-hidden="true"
          />
          <span id="workshop-status-label" class="font-semibold text-pro-green">
            {t.hero.openNow}
          </span>
        </span>
        <span class="hidden text-white/25 sm:inline" aria-hidden="true">·</span>
        <span class="text-text-secondary/90">{t.hero.hoursCompact}</span>
      </div>

      <h1 class="mt-4 font-display text-[2.45rem] leading-[0.95] font-extrabold tracking-tight uppercase sm:mt-5 sm:text-6xl lg:mt-6 lg:text-7xl">
        {t.hero.headlinePrefix}{' '}
        <span class="text-pro-green">{t.hero.headlineAccent}</span>
      </h1>

      <p class="mt-3 max-w-xl text-sm leading-relaxed text-text-secondary sm:mt-4 sm:text-base lg:mt-5 lg:text-lg">
        {t.hero.subtitle}
      </p>

      <div class="mt-5 grid grid-cols-2 gap-2.5 sm:mt-7 sm:flex sm:flex-wrap sm:items-center sm:gap-3.5 lg:mt-8">
        <a
          href="#marcacao"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-pro-green px-4 py-3 text-sm font-bold text-asphalt shadow-[0_10px_30px_rgba(82,175,61,0.22)] transition-all hover:bg-pro-green-hover sm:gap-2 sm:px-6 sm:py-3.5"
        >
          <span>{t.hero.primaryCta}</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={SITE_CONFIG.contact.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-white/15 bg-carbon/85 px-3.5 py-3 text-sm font-semibold text-text-primary backdrop-blur-sm transition-colors hover:border-pro-green/60 hover:bg-carbon-elevated sm:gap-2 sm:px-5 sm:py-3.5"
        >
          <svg class="h-4 w-4 shrink-0 text-pro-green sm:h-4.5 sm:w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.03 2a9.97 9.97 0 0 0-8.54 15.1L2 22l5.05-1.45A9.97 9.97 0 1 0 12.03 2Zm5.82 14.08c-.24.69-1.42 1.32-1.97 1.4-.52.08-1.18.11-1.9-.12-.44-.14-1-.33-1.72-.64-3.03-1.31-5-4.38-5.15-4.58-.15-.2-1.23-1.63-1.23-3.11 0-1.48.77-2.2 1.05-2.5.27-.3.6-.38.8-.38h.58c.19 0 .44-.07.69.52.25.6.85 2.08.92 2.23.08.15.13.33.03.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.54-.15.15-.3.31-.13.61.18.3.78 1.29 1.68 2.09 1.15 1.03 2.13 1.35 2.43 1.5.3.15.48.13.66-.08.18-.2.75-.88.95-1.18.2-.3.4-.25.68-.15.27.1 1.75.83 2.05.98.3.15.5.22.58.35.08.12.08.72-.17 1.4Z" />
          </svg>
          <span class="truncate">{t.hero.secondaryCta}</span>
        </a>
      </div>

      <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-white/8 pt-4 text-xs font-medium text-text-secondary sm:mt-8 sm:gap-x-6 sm:pt-5 sm:text-sm lg:mt-10 lg:pt-6">
        <li class="inline-flex items-center gap-1.5 sm:gap-2">
          <svg class="h-4 w-4 text-pro-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z" />
          </svg>
          <span>{t.hero.trustItems.multibrand}</span>
        </li>
        <li>
          <a
            href="#contactos"
            class="inline-flex items-center gap-1.5 transition-colors hover:text-pro-green sm:gap-2"
          >
            <svg class="h-4 w-4 text-pro-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6-5.686-6-10a6 6 0 1 1 12 0c0 4.314-6 10-6 10Z" />
              <circle cx="12" cy="11" r="2.2" />
            </svg>
            <span class="underline decoration-white/25 underline-offset-4 hover:decoration-pro-green">
              {t.hero.trustItems.location}
            </span>
          </a>
        </li>
        <li class="inline-flex items-center gap-1.5 sm:gap-2">
          <svg class="h-4 w-4 text-pro-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="5.5" cy="17.5" r="3" />
            <circle cx="18.5" cy="17.5" r="3" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 17.5h5l3-7.5h-4l-2 4m4.5-6h2.5" />
          </svg>
          <span>{t.hero.trustItems.vehicles}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { isWorkshopOpen } from '../lib/schedule';

  const pill = document.getElementById('workshop-status-pill');
  const dot = document.getElementById('workshop-status-dot');
  const label = document.getElementById('workshop-status-label');

  if (pill && dot && label) {
    const open = isWorkshopOpen(new Date());
    if (open) {
      label.textContent = pill.dataset.openText ?? 'ABERTO AGORA';
      label.classList.add('text-pro-green');
      label.classList.remove('text-status-warning');
      dot.classList.add('bg-pro-green');
      dot.classList.remove('bg-status-warning');
    } else {
      label.textContent = pill.dataset.closedText ?? 'FECHADO';
      label.classList.remove('text-pro-green');
      label.classList.add('text-status-warning');
      dot.classList.remove('bg-pro-green', 'shadow-[0_0_8px_rgba(82,175,61,0.85)]');
      dot.classList.add('bg-status-warning');
    }
  }
</script>
